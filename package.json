{
  "name": "dsh-purge",
  "version": "1.2.0",
  "description": "DeepSeek Harness 破甲 / 红队评测插件 —— 1.2 定制版（zhaofeng 定制）：以 1.1.90 为基线，攻击范围与道德裁决回退到 1.1.71 宽松口径（已停用区域与目标拦截）。",
  "author": "dsh-purge maintainers (upstream) · customized by zhaofeng",
  "contributors": [
    {
      "name": "zhaofeng",
      "url": "https://github.com/zhaofeng104"
    }
  ],
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": "./client.js",
    "./redteam": "./lib/redteam/index.js",
    "./redteam/store": "./lib/redteam/store.js",
    "./redteam/ui": "./lib/redteam/ui.js",
    "./redteam/tools": "./lib/redteam/tools.js",
    "./presets-plugin": "./lib/presets-plugin.js",
    "./package.json": "./package.json"
  },
  "bin": {
    "dsh-purge": "bin/dsh-purge.js"
  },
  "files": [
    "lib",
    "!lib/default-prompt-inject.md",
    "bin",
    "docs",
    "presets",
    "skills",
    "scripts",
    "client.js",
    "cordis.patch.yml",
    "screenshots.json",
    "README.md",
    "README.zh-CN.md",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "embed-prompt": "node scripts/embed-default-prompt.mjs",
    "build:client": "node scripts/build-client.mjs",
    "postinstall": "node scripts/ensure-profile-bundle.mjs"
  },
  "license": "Apache-2.0",
  "dshPurgeCustom": {
    "customizer": "zhaofeng",
    "customizerUrl": "https://github.com/zhaofeng104",
    "build": "1.2.0-custom",
    "basedOn": "HunYiSage/dsh-purge 1.1.90",
    "repo": "https://github.com/zhaofeng104/dsh-purge-custom"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "dsh-plugins",
    "网络安全",
    "红队评测",
    "llm-security",
    "harness-security",
    "deepseek-harness",
    "red-team",
    "instructions",
    "rules",
    "prompt-eval",
    "agent"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zhaofeng104/dsh-purge-custom.git"
  },
  "homepage": "https://github.com/zhaofeng104/dsh-purge-custom#readme",
  "bugs": {
    "url": "https://github.com/zhaofeng104/dsh-purge-custom/issues"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    },
    "install": {
      "preferred": "tarball",
      "tarball": "https://codeload.github.com/zhaofeng104/dsh-purge-custom/tar.gz/refs/heads/main",
      "zip": "https://codeload.github.com/zhaofeng104/dsh-purge-custom/zip/refs/heads/main",
      "git": "https://github.com/zhaofeng104/dsh-purge-custom.git"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1"
  },
  "engines": {
    "node": ">=18"
  },
  "dshTarget": "0.2.1-rc.2",
  "dshTargets": [
    "0.2.1-rc.2",
    "0.2.1-rc.5"
  ]
}
